# Copy this file to .env.local for local development.

# Random string used to sign the visitor's preferred light/dark theme cookie
SESSION_SECRET=replace-with-a-random-secret

# Neon PostgreSQL connection string used for the homepage view counter and global design
DATABASE_URL=replace-with-your-neon-connection-string

# Used when the global design setting is first created in the database.
# Supported values: murim, nano, classic.
DEFAULT_DESIGN=murim

# Bootstrap password; stored as a scrypt hash in Neon on first /admin visit
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional initial cookie-signing secret; if omitted, a random secret is generated
# and stored in Neon on first /admin visit
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
